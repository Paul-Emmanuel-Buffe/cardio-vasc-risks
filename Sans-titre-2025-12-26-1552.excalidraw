      "text": "try:\n        conn = psycopg2.connect(**DB_CONFIG)\n        cursor = conn.cursor()\n\n        requete_insertion = \"\"\"\n        INSERT INTO patients (id, age, gender, height, weight, ap_hi, ap_lo, cholesterol, gluc, smoke, alco, active, cardio)\n        VALUES %s\n        ON CONFLICT (id) DO NOTHING;\n        \"\"\"",
